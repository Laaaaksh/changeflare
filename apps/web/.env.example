# Copy this file to .env and fill in real values before running the app.

# Postgres connection string. docker-compose.yml provisions a matching database
# for local/self-hosted use — the default below matches its credentials.
DATABASE_URL="postgresql://changeflare:changeflare@localhost:5432/changeflare"

# Random secret used to sign admin session cookies. Generate one with:
#   openssl rand -base64 32
# Must be at least 16 characters; changing it logs everyone out.
SESSION_SECRET="replace-with-a-long-random-string"
