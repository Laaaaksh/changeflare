{
  "name": "@changeflare/web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm run copy:widget && next dev",
    "build": "prisma generate && node scripts/copy-widget.mjs && next build",
    "copy:widget": "node scripts/copy-widget.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@prisma/client": "7.10.0",
    "marked": "18.0.13",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "typescript": "7.0.2",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "vitest": "5.0.1"
  }
}
