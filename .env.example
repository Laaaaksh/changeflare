# Used by docker-compose.yml. Copy to .env and fill in a real secret before
# running `docker compose up`.
#
# Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Optional: only needed if 5432/3000 are already bound on your machine.
# POSTGRES_PORT=5433
# APP_PORT=3001
